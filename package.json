{
  "name": "longcelot-sheet-db",
  "version": "0.1.14",
  "description": "Google Sheets-backed staging database adapter for Node.js with schema-first design",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sheet-db": "dist/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills",
    "!skills/_artifacts"
  ],
  "keywords": [
    "google-sheets",
    "database",
    "staging",
    "adapter",
    "schema",
    "tanstack-intent"
  ],
  "author": "Longcelot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannseavlong/longcelot-sheet-staging.git"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "google-auth-library": "^10.6.2",
    "googleapis": "^172.0.0",
    "inquirer": "^8.2.7",
    "nanoid": "^3.3.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/intent": "latest",
    "@testing-library/dom": "^10.4.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
